NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Runtime role: least privilege, NOSUPERUSER, NOBYPASSRLS, not a table owner.
DATABASE_URL=postgresql://aptbooks_runtime@db.example.internal:5432/aptbooks
# Separate DDL/migration identity. Do not reuse DATABASE_URL credentials.
DATABASE_MIGRATOR_URL=postgresql://aptbooks_migrator@db.example.internal:5432/aptbooks
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
RLS_ENABLED=true
DB_ENFORCE_LEAST_PRIVILEGE=true

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=aptbooks-web
PASSWORD_RESET_TOKEN_PEPPER=replace-with-a-third-at-least-32-random-byte-secret
APP_SECRETS_ENCRYPTION_KEY=replace-with-64-hex-chars-or-32-byte-base64
BCRYPT_ROUNDS=12

REFRESH_TOKEN_USE_COOKIE=true
REFRESH_TOKEN_COOKIE_NAME=aptbooks_rt
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
PUBLIC_REGISTRATION_ENABLED=false
RETURN_RESET_TOKEN_IN_RESPONSE=false

RATE_LIMIT_STORE=postgres
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=5

EXPOSE_SWAGGER=false
EXPOSE_INTERNAL_UTILITIES=false
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# Phase 4 operations / observability
SERVICE_NAME=aptbooks-backend
APP_VERSION=replace-with-release-version
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Generate independently; do not reuse JWT/API/database credentials.
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes
TRACE_SAMPLE_RATIO=0.1
SLOW_REQUEST_MS=2000
SLOW_DB_QUERY_MS=1000
SHUTDOWN_GRACE_MS=30000
SLO_AVAILABILITY_TARGET=99.9
SLO_P95_LATENCY_MS=1000
